# Local development only. Copy to .env; never commit credentials.
# Generate a separate openssl rand -hex 24 value for each field below.
POSTGRES_PASSWORD=
APP_PASSWORD=
SESSION_SECRET=
APP_API_KEY=

# Works immediately without any provider account.
MODEL_MODE=mock
# To make real calls, use MODEL_MODE=openai-compatible and supply:
MODEL_NAME=claude-sonnet-5
MODEL_API_KEY=
MODEL_BASE_URL=https://ai.aiven.io/v1

# Optional self-hosted Langfuse. Set all three or leave all three empty.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Prompts/drafts stay out of traces unless explicitly enabled for synthetic data.
TRACE_CONTENT=false
APP_ENVIRONMENT=development
APP_RELEASE=
