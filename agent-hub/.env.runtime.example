# Set privately in the new Runtime service; never commit populated values.
HUB_BASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=backstage_agent_hub
# Single-line base64 of the complete PEM CA certificate, including BEGIN/END.
# Generate with: openssl base64 -A -in ca.pem
# The startup hook validates and decodes it; TLS verification stays enabled.
POSTGRES_CA_CERT_BASE64=
GITHUB_TOKEN=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
