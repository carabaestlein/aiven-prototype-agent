# Target: Aiven project cara-test. Reference only; store populated values as secrets.
# Never set LOCAL_DEVELOPMENT=true on Runtime.
DATABASE_URL=
PG_CA_CERT_BASE64=
APP_PASSWORD=
SESSION_SECRET=
APP_API_KEY=
MODEL_MODE=openai-compatible
MODEL_BASE_URL=https://ai.aiven.io/v1
MODEL_NAME=claude-sonnet-5
MODEL_API_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACE_CONTENT=false
APP_ENVIRONMENT=cara-test
# Record the immutable deployed Git commit here.
APP_RELEASE=
# No hosted LangSmith tracing. Its open-source client is a transitive dependency.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
